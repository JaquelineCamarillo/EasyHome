rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // --- Funciones auxiliares de autenticación y autorización ---

    function estaAutenticado() {
      return request.auth != null;
    }

    function miHogarId() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.hogarId;
    }

    function soyAdminDe(hid) {
      let yo = get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
      return yo.hogarId == hid && yo.esAdministrador == true;
    }

    function esTextoValido(val, minLen, maxLen) {
      return val is string && val.size() >= minLen && val.size() <= maxLen;
    }

    function esCostoValido(data) {
      return !('costo' in data) || data.costo == null || (data.costo is number && data.costo >= 0);
    }

    function esDescripcionValida(data, maxLen) {
      return !('descripcion' in data) || data.descripcion == null || (data.descripcion is string && data.descripcion.size() <= maxLen);
    }

    // --- Colección: usuarios ---
    match /usuarios/{uid} {
      // Lectura: Únicamente el propio usuario o integrantes que pertenezcan a su mismo hogar
      allow read: if estaAutenticado() && (
        request.auth.uid == uid ||
        (resource.data.hogarId != null && resource.data.hogarId == miHogarId())
      );

      // Creación: Al registrarse, solo puede crear su propio perfil con esAdministrador en false y sin hogar
      allow create: if estaAutenticado()
                    && request.auth.uid == uid
                    && esTextoValido(request.resource.data.nombre, 1, 60)
                    && request.resource.data.esAdministrador == false
                    && request.resource.data.hogarId == null
                    && (!('correo' in request.resource.data) || request.resource.data.correo is string);

      // Actualización:
      // 1. El propio usuario actualiza solo nombre, avatarColor o correo propio
      // 2. El propio usuario se une a un hogar
      // 3. El propio usuario crea un hogar y se vuelve admin (permite múltiples hogares si es admin)
      // 4. El propio usuario se sale del hogar o cambia su hogar activo entre sus hogaresIds
      // 5. El administrador del hogar cambia el rol de un integrante o lo expulsa
      allow update: if estaAutenticado() && (
        // Caso 1: Actualizar nombre, avatar o correo propio
        (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre', 'avatarColor', 'correo'])
          && (!('nombre' in request.resource.data) || esTextoValido(request.resource.data.nombre, 1, 60))
          && (!('correo' in request.resource.data) || request.resource.data.correo is string))

        // Caso 2: Unirse a un hogar o cambiar de hogar activo
        || (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hogarId', 'hogaresIds', 'esAdministrador'])
          && request.resource.data.hogarId is string
          && exists(/databases/$(database)/documents/hogares/$(request.resource.data.hogarId))
          && (
            request.resource.data.esAdministrador == false
            || get(/databases/$(database)/documents/hogares/$(request.resource.data.hogarId)).data.creadoPor == request.auth.uid
            || request.resource.data.esAdministrador == resource.data.esAdministrador
          ))

        // Caso 3: Crear hogar (se vuelve admin solo si en la misma tx creó el hogar)
        || (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hogarId', 'hogaresIds', 'esAdministrador'])
          && request.resource.data.esAdministrador == true
          && getAfter(/databases/$(database)/documents/hogares/$(request.resource.data.hogarId)).data.creadoPor == request.auth.uid)

        // Caso 4: Salirse del hogar voluntariamente
        || (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hogarId', 'hogaresIds', 'esAdministrador'])
          && (request.resource.data.hogarId == null || request.resource.data.hogarId is string))

        // Caso 5: Admin del hogar promueve/degrada, actualiza correo o expulsa a un integrante de su hogar
        || (resource.data.hogarId != null
          && soyAdminDe(resource.data.hogarId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hogarId', 'esAdministrador', 'correo'])
          && (!('correo' in request.resource.data) || request.resource.data.correo is string)
          && (
            (request.resource.data.hogarId == resource.data.hogarId && request.resource.data.esAdministrador is bool)
            || (request.resource.data.hogarId == null && request.resource.data.esAdministrador == false)
          ))

        // Caso 6: Guardar o borrar el propio token FCM (notificaciones push, #21)
        || (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken'])
          && (!('fcmToken' in request.resource.data) || (request.resource.data.fcmToken is string && request.resource.data.fcmToken.size() <= 4096)))

        // Caso 7: Actualizar la lista propia de espacios (hogaresIds)
        || (request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hogaresIds'])
          && request.resource.data.hogaresIds is list)
      );

      // Eliminación prohibida para preservar integridad histórica
      allow delete: if false;
    }

    // --- Colección: hogares ---
    match /hogares/{hogarId} {
      // Lectura: Integrantes del hogar, creador del espacio o búsqueda por código de invitación
      allow read: if estaAutenticado() && (
        miHogarId() == hogarId
        || resource.data.creadoPor == request.auth.uid
        || resource.data.codigoInvitacion is string
      );

      // Creación: Usuario autenticado que se asigna como creador con datos válidos
      allow create: if estaAutenticado()
                    && request.resource.data.creadoPor == request.auth.uid
                    && esTextoValido(request.resource.data.nombre, 1, 50)
                    && esTextoValido(request.resource.data.codigoInvitacion, 6, 8);

      // Actualización: Solo administradores de ese hogar (cambiar nombre o regenerar código)
      allow update: if estaAutenticado()
                    && miHogarId() == hogarId
                    && soyAdminDe(hogarId)
                    && request.resource.data.creadoPor == resource.data.creadoPor;

      allow delete: if false;
    }

    // --- Colección: productos (Lista de compras) ---
    match /productos/{productoId} {
      allow read: if estaAutenticado() && resource.data.hogarId == miHogarId();

      allow create: if estaAutenticado()
                    && request.resource.data.hogarId == miHogarId()
                    && esTextoValido(request.resource.data.nombre, 1, 120)
                    && request.resource.data.cantidad is int
                    && request.resource.data.cantidad > 0
                    && request.resource.data.comprado is bool
                    && esCostoValido(request.resource.data)
                    && esDescripcionValida(request.resource.data, 250);

      allow update: if estaAutenticado()
                    && resource.data.hogarId == miHogarId()
                    && request.resource.data.hogarId == resource.data.hogarId
                    && esTextoValido(request.resource.data.nombre, 1, 120)
                    && request.resource.data.cantidad is int
                    && request.resource.data.cantidad > 0
                    && request.resource.data.comprado is bool
                    && esCostoValido(request.resource.data)
                    && esDescripcionValida(request.resource.data, 250);

      allow delete: if estaAutenticado() && resource.data.hogarId == miHogarId();
    }

    // --- Colección: quehaceres ---
    match /quehaceres/{quehacerId} {
      allow read: if estaAutenticado() && resource.data.hogarId == miHogarId();

      // Solo el administrador del hogar puede crear quehaceres
      allow create: if estaAutenticado()
                    && soyAdminDe(request.resource.data.hogarId)
                    && request.resource.data.creadoPor == request.auth.uid
                    && request.resource.data.hecho == false
                    && esTextoValido(request.resource.data.titulo, 1, 120)
                    && request.resource.data.recurrente is bool
                    && esDescripcionValida(request.resource.data, 300);

      allow update: if estaAutenticado() && (
        // 1. Admin del hogar puede actualizar cualquier campo sin cambiar de hogar
        (soyAdminDe(resource.data.hogarId)
          && request.resource.data.hogarId == resource.data.hogarId
          && esTextoValido(request.resource.data.titulo, 1, 120)
          && esDescripcionValida(request.resource.data, 300))

        // 2. El integrante asignado puede únicamente marcar o desmarcar el estado 'hecho'
        || (resource.data.asignadoA == request.auth.uid
          && resource.data.hogarId == miHogarId()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hecho'])
          && request.resource.data.hecho is bool)

        // 3. Rotación semanal (#20): Cualquier integrante del hogar rota quehaceres recurrentes
        || (resource.data.hogarId == miHogarId()
          && resource.data.recurrente == true
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['asignadoA', 'hecho'])
          && request.resource.data.hecho is bool)
      );

      // Solo el admin del hogar puede eliminar quehaceres
      allow delete: if estaAutenticado() && soyAdminDe(resource.data.hogarId);

      // Subcolección: comentarios (#Requerimiento 1 Retro)
      match /comentarios/{comentarioId} {
        // Solo integrantes del mismo hogar pueden leer los comentarios
        allow read: if estaAutenticado()
                    && get(/databases/$(database)/documents/quehaceres/$(quehacerId)).data.hogarId == miHogarId();

        // Cualquier integrante del mismo hogar puede escribir un comentario (1 a 300 caracteres)
        allow create: if estaAutenticado()
                      && get(/databases/$(database)/documents/quehaceres/$(quehacerId)).data.hogarId == miHogarId()
                      && request.resource.data.autorId == request.auth.uid
                      && esTextoValido(request.resource.data.texto, 1, 300)
                      && esTextoValido(request.resource.data.autorNombre, 1, 60);

        // Inmutables: no se pueden editar ni borrar comentarios para preservar el historial
        allow update, delete: if false;
      }
    }

    // --- Colección en desuso o cerrada: codigosInvitacion ---
    // Los códigos se gestionan de forma segura embebidos en el documento de cada hogar
    match /codigosInvitacion/{codigoId} {
      allow read, write: if false;
    }

    // --- Regla por defecto (Default Deny / Catch-All) ---
    // Deniega explícitamente lectura y escritura a cualquier colección o documento no declarado
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
